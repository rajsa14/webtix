{
  // Cloudflare Worker for webtix.cz. Pages come from dist/ (npm run build);
  // only /api/* runs worker/index.ts.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webtix",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Every page address loads the app, which decides what to show.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Must be on a domain verified in Resend. RESEND_API_KEY is a secret set in the dashboard.
    "INQUIRY_FROM": "WebTix <poptavky@danielsveda.cz>"
  },
  // At most 5 inquiries per minute from one IP address.
  "ratelimits": [
    {
      "name": "INQUIRY_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
