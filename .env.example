# Where the inquiry form sends its data. Leave empty to use the Cloudflare
# Worker at /api/inquiry (worker/index.ts). In local `npm run dev` there is no
# Worker, so the site offers the visitor a prepared e-mail instead.
#
# Formspree (form id is public, not a secret):
# VITE_INQUIRY_ENDPOINT=https://formspree.io/f/xxxxxxxx
#
# Local testing only, prints the inquiry in the dev server terminal:
# VITE_INQUIRY_ENDPOINT=/api/dev-inquiry
VITE_INQUIRY_ENDPOINT=

# Server-side only (worker/index.ts). Set as a secret in Cloudflare > Workers > webtix >
# Settings > Variables and Secrets. Never prefix with VITE_, never commit.
# For `npx wrangler dev`, put it in .dev.vars. INQUIRY_FROM is set in wrangler.jsonc.
# RESEND_API_KEY=

# Password for the /admin dashboard (netlify/functions/admin.mts). Server-side only.
# Use a long random one. Locally put it in .env.local, on Netlify in Environment variables.
# ADMIN_PASSWORD=
