# Where the inquiry form sends its data. Leave empty to use Netlify Forms
# (form "poptavka"; turn on form detection and an e-mail notification in
# Netlify > Forms). Where Forms are unavailable, e.g. a copy opened from disk,
# the site offers the visitor a prepared e-mail instead.
#
# Netlify Function (netlify/functions/inquiry.mts):
# VITE_INQUIRY_ENDPOINT=/api/inquiry
#
# Formspree (form id is public, not a secret):
# VITE_INQUIRY_ENDPOINT=https://formspree.io/f/xxxxxxxx
#
# Local testing only, prints the inquiry in the dev server terminal:
# VITE_INQUIRY_ENDPOINT=/api/dev-inquiry
VITE_INQUIRY_ENDPOINT=

# Server-side only (netlify/functions/inquiry.mts). Never prefix with VITE_, never commit.
# RESEND_API_KEY=
# INQUIRY_FROM="WebTix <poptavky@vase-domena.cz>"
